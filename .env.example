# Copy to .env for local development. Every setting has a working default -- this file
# exists to show the shape and to say which ones a deployment must actually think about.
# Full reference and the hardening checklist: docs/operations.md
#
# A USER_API_-prefixed variable that matches no setting is a STARTUP ERROR, not a warning.
# A typo in USER_API_ALLOWED_SCOPES would otherwise leave the scope list on its default,
# and a deployment that believed it had compartmentalised an assistant would not have.

# --- Identity and logging -----------------------------------------------------------
USER_API_ENVIRONMENT=local
USER_API_LOG_LEVEL=INFO
# json in deployment, console for readable local output
USER_API_LOG_FORMAT=console

# --- Serving ------------------------------------------------------------------------
# Loopback on purpose. This service belongs behind a TLS-terminating proxy.
USER_API_HOST=127.0.0.1
USER_API_PORT=8002

# --- Storage ------------------------------------------------------------------------
# One SQLite file, holding personal data IN PLAINTEXT. Created 0600 along with its
# -wal/-shm sidecars, which is the only access control there is -- see ADR-0003 for what
# that protects and what it does not. Never inside a directory anything serves from.
# Back it up with `VACUUM INTO`, never `cp`: see docs/operations.md.
USER_API_DATABASE_PATH=var/user.db

# --- Who we believe -----------------------------------------------------------------
# REQUIRED IN DEPLOYMENT, both of them. This service never calls keyring at request time;
# it fetches this document and verifies tokens locally against it.
USER_API_KEYRING_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
# Pinned against every token's `iss`. A token from anywhere else is not a token.
USER_API_KEYRING_ISSUER=http://127.0.0.1:8001

# The audience family this service answers to. `user` alone grants nothing beyond
# unscoped entries; `user.health` grants the `health` scope. A token minted for another
# service is refused outright.
USER_API_AUDIENCE_PREFIX=user

# Every scope a token may name. Configuration rather than an open set, so an audience
# naming an unknown scope is a 401 rather than a token that silently grants nothing and
# reads like a correctly configured assistant that has just not been told anything yet.
USER_API_ALLOWED_SCOPES='["home","work","health","family","finance"]'

USER_API_JWKS_CACHE_SECONDS=3600
# Floor between two fetches provoked by an unknown key id. Without it, a stream of tokens
# carrying invented kids is one outbound request to keyring per inbound request -- an
# amplifier anybody who can reach this service can aim.
USER_API_JWKS_MIN_REFETCH_SECONDS=60
USER_API_KEYRING_HTTP_TIMEOUT_SECONDS=5

# --- Erasure ------------------------------------------------------------------------
# The default grace window a new record starts with. Per-account, and the person can
# change theirs to `immediate` or `tombstone` through the API.
USER_API_DEFAULT_GRACE_DAYS=30
# How often the sweeper destroys what is due. The checkpoint that actually removes the
# bytes runs once per sweep, so this is also how often that cost is paid.
USER_API_PURGE_INTERVAL_SECONDS=3600

# --- Limits -------------------------------------------------------------------------
USER_API_MAX_ENTRIES_PER_ACCOUNT=5000
USER_API_MAX_FIELDS_PER_ACCOUNT=500
# The always-load block goes into a context window. This is a token budget, not a taste.
USER_API_MAX_PINNED=40
USER_API_MAX_VALUE_BYTES=4096
USER_API_MAX_VALUE_DEPTH=3
USER_API_MAX_NOTE_CHARS=4000
USER_API_MAX_EVENTS=10000

# --- Retrieval ----------------------------------------------------------------------
USER_API_SEARCH_DEFAULT_LIMIT=20
USER_API_SEARCH_MAX_LIMIT=100

# --- Deliberately absent ------------------------------------------------------------
# There is no setting that disables token verification.
# There is no setting that lets one account read another's record.
# There is no setting that turns off the credential refusal.
# There is no setting that accepts an unsigned or HS256 token.
# There is no setting by which a caller-supplied scope can widen what its token grants.
# Each would be a one-variable route past the property this service is built around.
