# The LUCY-assistant family standard. Every service repository carries a copy of this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# ruff enforces the same limit (line-length = 100).
max_line_length = 100

[*.{yml,yaml,json,jsonc,code-workspace}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
